<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.tankun.collab.app</string>
  <!-- Launched through `open` rather than by running the executable directly,
       so LaunchServices treats it as the one instance and a collab:// URL wakes
       that instance instead of starting a second one. -->
  <key>ProgramArguments</key> <array>
                                <string>/usr/bin/open</string>
                                <string>-a</string>
                                <string>/Users/ts/Applications/Collab.app</string>
                              </array>
  <key>RunAtLoad</key>        <true/>
  <!-- No KeepAlive: quitting from the menu should mean quit until next login,
       and `open` exits immediately anyway, so KeepAlive would just respawn it. -->
</dict>
</plist>
