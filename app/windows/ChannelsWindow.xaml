<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Collab.ChannelsWindow"
        Title="Channels" Height="520" Width="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid x:Name="Root" Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="Blurb" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12"
               Text="A channel is a separate conversation with its own key. Both machines need the same key, or neither sees the other. Only a person can make one."/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Rows"/>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="MakeLabel" Text="Make a channel" FontWeight="SemiBold" Margin="0,0,0,5"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="NewName" Padding="7,5"/>
        <Button x:Name="MakeBtn" Grid.Column="1" Content="Make" Click="OnMake"
                Padding="16,5" Margin="8,0,0,0" FontWeight="SemiBold"/>
      </Grid>
      <TextBlock x:Name="JoinLabel" Text="Or join one someone sent you" FontWeight="SemiBold" Margin="0,12,0,5"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="JoinName" Width="130" Padding="7,5" Margin="0,0,8,0"/>
        <TextBox x:Name="JoinKey" Grid.Column="1" Padding="7,5" FontFamily="Consolas" FontSize="11"/>
        <Button x:Name="JoinBtn" Grid.Column="2" Content="Join" Click="OnJoin"
                Padding="16,5" Margin="8,0,0,0"/>
      </Grid>
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <TextBlock x:Name="Note" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"/>
      <Button Content="Done" Click="OnDone" Padding="20,5" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
